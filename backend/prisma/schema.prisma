datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(uuid())
  googleId  String?    @unique
  name      String
  email     String     @unique
  avatarUrl String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]
}

model Sender {
  id           String   @id @default(uuid())
  email        String
  name         String
  smtpHost     String
  smtpPort     Int
  smtpUser     String
  smtpPassword String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  emails       Email[]
}

model Campaign {
  id           String   @id @default(uuid())
  userId       String
  subject      String
  body         String
  startTime    DateTime
  delaySeconds Int
  hourlyLimit  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails       Email[]
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum QueueStatus {
  PENDING
  QUEUED
}

model Email {
  id                  String      @id @default(uuid())
  campaignId          String
  senderId            String
  recipient           String
  subject             String
  body                String
  scheduledAt         DateTime
  originalScheduledAt DateTime?
  sentAt              DateTime?
  status              EmailStatus @default(SCHEDULED)
  queueStatus         QueueStatus @default(PENDING)
  attempts            Int         @default(0)
  bullJobId           String?     @unique
  errorMessage        String?
  messageId           String?
  previewUrl          String?
  processingStartedAt DateTime?
  processingToken     String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  campaign            Campaign    @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  sender              Sender      @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([queueStatus])
  @@index([scheduledAt])
  @@index([processingStartedAt])
  @@index([campaignId])
  @@index([recipient])
  @@index([senderId])
}

