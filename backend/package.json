{
  "name": "email-scheduler-backend",
  "version": "1.0.0",
  "description": "Backend service for Email Scheduler",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "worker:dev": "ts-node-dev --respawn --transpile-only src/queue/email.worker.ts",
    "worker": "node dist/queue/email.worker.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:ethereal": "ts-node src/utils/test-ethereal.ts",
    "test:load": "ts-node src/utils/load-test.ts",
    "queue:recover": "ts-node src/utils/recover-cli.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bullmq": "^5.8.2",
    "connect-redis": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^6.4.15",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.18.0",
    "rimraf": "^5.0.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
